{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Debug"
    },
    "AKNexusLog": {
      "LogLevel": {
        "Default": "Information",
        "AKNexus": "Debug" // 自己的命名空间，输出调试
      },
      // 在这里做最小扩展，挂载你的物理写入配置
      "EnableConsole": true,
      "EnableFile": true,
      "FilePath": "logs/hub.log",
      "MaxFileSizeMB": 10,
      "RetainedDays": 10
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=AKNexusHub_Dev;Username=postgres;Password=postgres"
  },
  "Swagger": {
    "Enabled": true
  }
}