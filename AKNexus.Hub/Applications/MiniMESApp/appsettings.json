{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    },
    "AKNexusLog": {
      "LogLevel": {
        "Default": "Information",
        "AKNexus": "Warning"
      },
      "EnableConsole": true,
      "EnableFile": true,
      "FilePath": "logs/aknexus.log",
      "MaxFileSizeMB": 60,
      "RetainedDays": 120
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=AKNexusHub;Username=postgres;Password=postgres",
    "DASApp": "Host=localhost;Port=5432;Database=mes_gate;Username=postgres;Password=postgres",
    "SqlServer": "Server=localhost;Database=AKNexusHub;User Id=sa;Password=ldl7311;TrustServerCertificate=True",
    "MySql": "Server=localhost;Database=AKNexusHub;User=root;Password=ldl7311",
    "Sqlite": "Data Source=AKNexusHub.db"
  },
  "DatabaseConfig": {
    "ConnectionStringName": "Default"
  },
  "DASApp": {
    "ConnectionStringName": "DASApp"
  },
  "JWT": {
    "ValidateIssuerSigningKey": true,
    "IssuerSigningKey": "your_secret_key_here_replace_with_actual_key",
    "ValidateIssuer": true,
    "ValidIssuer": "AKNexus.Hub",
    "ValidateAudience": true,
    "ValidAudience": "AKNexus.Client",
    "ValidateLifetime": true,
    "ExpiredTime": 24,
    "ClockSkew": 5
  },
  "Redis": {
    "ConnectionString": "localhost:6379,password=,defaultDatabase=0",
    "InstanceName": "AKNexus:"
  },
  "AllowedHosts": "*",
  "Swagger": {
    "Enabled": true,
    "Title": "DASApp API",
    "Version": "v1",
    "Description": "DASApp MES API Documentation"
  },
  "SpecificationDocumentSettings": {
    "DocumentTitle": "MiniMES API 文档",
    "EnableAllGroups": true
  }
}
