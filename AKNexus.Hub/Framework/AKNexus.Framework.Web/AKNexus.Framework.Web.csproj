<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>AKNexus.Framework.Web</RootNamespace>
        <Description>Framework Web 基础层 - API 规范</Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- API 版本控制（可选） -->
        <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.29" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\AKNexus.Core\AKNexus.Core.csproj" />
        <ProjectReference Include="..\AKNexus.Framework.Abstractions\AKNexus.Framework.Abstractions.csproj" />
        <ProjectReference Include="..\AKNexus.Framework.Application\AKNexus.Framework.Application.csproj" />
        <ProjectReference Include="..\AKNexus.Framework.Infrastructure\AKNexus.Framework.Infrastructure.csproj" />
    </ItemGroup>

</Project>